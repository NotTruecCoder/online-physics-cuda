# HESTON as a law (bench/finance.py): two dimensions, x = ln S along the lattice's x and the variance along its y,
# scaled so one lattice spacing serves both: var = sig_v * y. In time to maturity tau, with V_var = V_y / sig_v:
#
#   dV/dtau = 1/2 var (V_xx + V_yy) + rho var V_xy + (r - 1/2 var) V_x + kappa (theta - var) / sig_v V_y - r V
#
# Every derivative second order:
#   V_xx       the three-point stencil (shift), zero flux at the x ends.
#   var V_yy   the flux form d/dy(var V_y) less sig_v V_y (var_y = sig_v). var is linear in y, so the face values
#              var +- sig_v h / 2 are exact (no mean of two cells: a harmonic one is 25% off at the first face); the face
#              at var = 0 carries nothing, which is the PDE's own boundary there (no diffusion, the drift points in).
#   V_xy       gx(gy(V)), the four-corner stencil.
#   V_y        drift b = kappa (theta - var) / sig_v - sig_v / 2 (the flux form's correction folded in), second-order
#              upwind: (4 V(y+1) - V(y+2) - 3 V) / 2h where b > 0, (3 V - 4 V(y-1) + V(y-2)) / 2h where b < 0.
# Explicit Euler with dt ~ h^2: order 2 in h overall. The step limit is the diffusion's or the drift's (CFL), the
# smaller. Each cell's variance is a static field (the cell centre's), written by the driver. (Not `v`: V.bin and v.bin
# are one file on a case-blind file system.) heston_first_order.law is the scheme this replaced.
field V init 0 range -1 1000000
field var init 0 range 0 100 static

param sig_v = 0.3
param kappa = 1.5
param theta = 0.04
param rho = -0.9
param r = 0.025
param var_max = 0.6          # the largest cell variance (the driver sets it): the step limit, without a reduction

term heston
  d V = 0.5 * var * (shift(V, 1, 0, 0) - 2 * V + shift(V, -1, 0, 0)) / (h * h) + 0.5 * ((var + 0.5 * sig_v * h) * (shift(V, 0, 1, 0) - V) - (var - 0.5 * sig_v * h) * (V - shift(V, 0, -1, 0))) / (h * h) + rho * var * gx(gy(V)) + (r - 0.5 * var) * gx(V) + pos(kappa * (theta - var) / sig_v - 0.5 * sig_v) * (4 * shift(V, 0, 1, 0) - shift(V, 0, 2, 0) - 3 * V) / (2 * h) - pos(0.5 * sig_v - kappa * (theta - var) / sig_v) * (3 * V - 4 * shift(V, 0, -1, 0) + shift(V, 0, -2, 0)) / (2 * h) - r * V
  max_dt = min(0.2 * h * h / var_max, 0.5 * h / (abs(r) + 0.5 * var_max + (kappa * max(theta, var_max - theta) + 0.5 * sig_v * sig_v) / sig_v))
