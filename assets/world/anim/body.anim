key 1.656 root -0.2,0,-18.84 arm_r 1.25,-0.32 arm_l 1.25,-0.32 grip -1.15
key 1.688 root -0.2,0,-19.63 arm_r 1.25,-0.32 arm_l 1.25,-0.32 grip -1.15
