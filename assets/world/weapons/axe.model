  box  2 0 0  19 0 0  haft
  box 13 -1 -3  19 1 -1  head
  box 12 -1 -5  20 0 -4  head
  box 11 0 -7  21 0 -6  edge
  box 14 -1 1 18 1 2 head
  box 14 0 3 18 0 4 edge
  dot 16 1 -2 rivet
